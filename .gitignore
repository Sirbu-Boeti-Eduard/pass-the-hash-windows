paper/main.pdf

# Evidence: large captures stay local or go in a release, not in git history
poc/evidence/**/*.pcap
poc/evidence/**/*.pcapng
poc/evidence/**/*.zip
poc/evidence/**/*.7z
poc/evidence/**/*.evtx

# Lab secrets: never commit hashes, keys or credentials from the lab
poc/**/secrets.local.*
poc/**/*.kirbi
poc/**/*.pfx
